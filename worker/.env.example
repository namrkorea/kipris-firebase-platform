# Firebase Storage
FIREBASE_STORAGE_BUCKET=kipris-firebase-platform.firebasestorage.app

# KIPRIS
KIPRIS_SERVICE_KEY=YOUR_KIPRIS_SERVICE_KEY
KIPRIS_SEARCH_URL=https://plus.kipris.or.kr/kipo-api/kipi/patUtiModInfoSearchSevice/getAdvancedSearch
KIPRIS_DETAIL_URL=https://plus.kipris.or.kr/kipo-api/kipi/patUtiModInfoSearchSevice/getBibliographyDetailInfoSearch
KIPRIS_PDF_URL=https://plus.kipris.or.kr/kipo-api/kipi/patUtiModInfoSearchSevice/getPubFullTextInfoSearch

KIPRIS_MAX_RETRIES=3
KIPRIS_REQUEST_INTERVAL=0.6
KIPRIS_RETRY_BACKOFF=2

# Worker
WORKER_ID=local-worker-01
POLL_SECONDS=5
REQUEST_TIMEOUT=60

# PDF / Storage
PDF_BUCKET=patent-pdfs
MAX_PDF_BYTES=52428800
STORAGE_MAX_RETRIES=3
